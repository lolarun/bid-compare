# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Database
data/*.db
data/*.db-wal
data/*.db-shm

# Uploaded files (handled at runtime; not source-controlled)
data/uploads/

# Environment files (contain secrets)
.env
apps/api/.env
apps/www/.env
*.env.local

# Node
web/node_modules/
web/dist/
apps/www/node_modules/
apps/www/dist/

# IDE
.idea/
.vscode/
*.swp

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
docs/antdv-pro/

# Generated test outputs
outputs/

# Local temp test artifacts
_*.json
_*.txt
_*.xlsx
e2e_*.log
e2e_out*.txt
*.log

# API / dev server temp output
api.out
api.err
www.out
uvicorn_startup.log.err
nul

# Temporary OCR/debug HTML files (scripts produce these)
tmp_*.html
tmp_*.json
tmp_*.txt

# OCR snapshots in outputs/ are transient; controlled fixtures are in tests/fixtures/
outputs/ocr_snapshots/

# scripts/ 自 2026-08-10 起入库（此前为 keep local only）。
# 理由：诊断脚本承载了识别链路的实验方法——单变量 A/B 台架、方向固定、
# 打分口径——这些不入库，下一个人只能重做一遍已经做过的实验。
# 约束仍按 .claude/rules/database-safety.md：脚本必须参数化，禁止写死
# 本机路径与密钥；默认只读，写模式需显式参数。
# 一次性中间产物不入库：
scripts/**/*.json

# Local data directory and temp directories
tmp/
data/test_*/
data/debug_*/
