# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Database
data/*.db
data/*.db-wal
data/*.db-shm

# Uploaded files (handled at runtime; not source-controlled)
data/uploads/

# Environment files (contain secrets)
.env
apps/api/.env
apps/www/.env
*.env.local

# Node
web/node_modules/
web/dist/
apps/www/node_modules/
apps/www/dist/

# IDE
.idea/
.vscode/
*.swp

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
docs/antdv-pro/

# Generated test outputs
outputs/

# Local temp test artifacts
_*.json
_*.txt
_*.xlsx
e2e_*.log
e2e_out*.txt
*.log

# API / dev server temp output
api.out
api.err
www.out
uvicorn_startup.log.err
nul

# Temporary OCR/debug HTML files (scripts produce these)
tmp_*.html
tmp_*.json
tmp_*.txt

# OCR snapshots in outputs/ are transient; controlled fixtures are in tests/fixtures/
outputs/ocr_snapshots/

# Script test outputs
scripts/test_e2e_alignment_result.json
