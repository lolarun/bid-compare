{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["apps.api.main:app", "--port", "8020"],
      "port": 8020,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5120"],
      "cwd": "apps/www",
      "port": 5120,
      "autoPort": false
    }
  ]
}
