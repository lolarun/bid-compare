* text=auto

# Repository source and documentation use LF on every platform.
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Native Windows launchers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Customer documents and test corpora are binary. Large new files must also
# satisfy the repository manifest/allow-list policy before they are committed.
*.7z binary
*.doc binary
*.docx binary
*.dwg binary
*.jpg binary
*.pdf binary
*.png binary
*.pptx binary
*.xls binary
*.xlsx binary
*.zip binary
