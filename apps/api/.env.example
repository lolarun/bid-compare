# MEMPAS Backend Environment Configuration (template)
# Copy to apps/api/.env and fill in real values (do NOT commit .env)

# ── LLM — DashScope (Alibaba Cloud) ─────────────────────────────────────
DASHSCOPE_API_KEY=sk-replace-me
# Optional: comma-separated list of keys for multi-key rotation (up to 4×6=24 concurrent pages)
# DASHSCOPE_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=dashscope_ocr  # dashscope_ocr | mock
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-latest
DASHSCOPE_LLM_MODEL=qwen3.6-flash

# ── PaddleOCR-VL — Baidu Cloud (design/26 §5) ───────────────────────────────
# 同一对键名 scripts/try_paddleocr_vl.py 已在用（同一个百度云应用凭据，产品端点
# 从 unlimited-ocr-parser 换成 paddle-vl-parser）——两处读同一份 .env，不重复配置。
BAIDU_UNLIMITED_OCR_API_KEY=replace-me
BAIDU_UNLIMITED_OCR_SECRET_KEY=replace-me

# ── File upload storage ───────────────────────────────────────────────────
UPLOAD_DIR=data/uploads

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
