# MEMPAS Backend Environment Configuration (template)
# Copy to apps/api/.env and fill in real values (do NOT commit .env)

# ── LLM — DashScope (Alibaba Cloud) ─────────────────────────────────────
DASHSCOPE_API_KEY=sk-replace-me
# Optional: comma-separated list of keys for multi-key rotation (up to 4×6=24 concurrent pages)
# DASHSCOPE_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=dashscope_ocr  # dashscope_ocr | mock
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-latest
DASHSCOPE_LLM_MODEL=qwen3.6-flash

# ── LLM — MiMo (Xiaomi), the current DEFAULT vendor ─────────────────────────
# REQUIRED as of 2026-08-27: domain_config.TEXT_CLIENT_VENDOR and
# VISION_CLIENT_VENDOR both default to 'mimo'. Leaving this unset is *safe* —
# every call site falls back to DashScope and logs a warning — but it is also
# *invisible*: the deployment silently runs the old vendor on all 8 migrated
# call sites (cover-page scalars, card summary, bid_insight, material enhance,
# block_alignment, scanned bid/tender classification, gap-fill, tender
# VL-direct fallback), and nothing but a log line says so. Set it, or flip the
# two switches in domain_config.py back to 'dashscope' deliberately.
# Not covered by this switch: embeddings — MiMo has no embedding API, so
# anchor_match._embed stays on DashScope by hard constraint, not oversight.
MIMO_API_KEY=replace-me
# Page-filter cost reduction (docs/spec/TECHNICAL.md §3.3) is a SEPARATE
# decision from the vendor default and has its own switch,
# domain_config.PAGE_FILTER_ENABLED (default False). Setting MIMO_API_KEY does
# not turn it on. ~79% less Paddle spend, ~33% slower end-to-end — the
# tradeoff is still undecided (§8), so it ships off.

# ── PaddleOCR-VL — Baidu Cloud (design/26 §5) ───────────────────────────────
# 同一对键名 scripts/try_paddleocr_vl.py 已在用（同一个百度云应用凭据，产品端点
# 从 unlimited-ocr-parser 换成 paddle-vl-parser）——两处读同一份 .env，不重复配置。
BAIDU_UNLIMITED_OCR_API_KEY=replace-me
BAIDU_UNLIMITED_OCR_SECRET_KEY=replace-me

# ── File upload storage ───────────────────────────────────────────────────
UPLOAD_DIR=data/uploads

# ── CORS ─────────────────────────────────────────────────────────────────
# 5120 is the fixed dev frontend port (CLAUDE.md §3); 3000/5173 are kept for
# older local setups. Must stay in sync with Settings.CORS_ORIGINS in
# apps/api/core/config.py, which already lists 5120.
CORS_ORIGINS=http://localhost:5120,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5120,http://127.0.0.1:3000,http://127.0.0.1:5173
